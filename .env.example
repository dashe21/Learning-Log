# Flask Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=production

# Database Configuration (choose one)
# For PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/learning_log
# POSTGRES_DB=learning_log
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# For SQLite (development/small deployments)
DATABASE_URL=sqlite:////app/instance/learning_log.db

# Security Configuration - adjust as needed
SSL_DISABLE=ture
SECURE_HEADERS=false

# Docker User Mapping (for SQLite deployment)
UID=1000
GID=1000